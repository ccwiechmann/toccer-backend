<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>de.ccw.toccer</groupId>
	<artifactId>toccer-backend</artifactId>
	<version>0.0.1</version>
	<packaging>jar</packaging>

	<name>toccer-backend</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>25</maven.compiler.release>
	</properties>

	<dependencies>
		<!-- HTML tolerant parser used by Saxon to render broken/incomplete web pages. -->
		<dependency>
			<groupId>org.ccil.cowan.tagsoup</groupId>
			<artifactId>tagsoup</artifactId>
			<version>1.2.1</version>
		</dependency>

		<!-- XSLT / XPath 3.1 processor (free tier). -->
		<dependency>
			<groupId>net.sf.saxon</groupId>
			<artifactId>Saxon-HE</artifactId>
			<version>13.0</version>
		</dependency>

		<!-- Small utilities: normalizeSpace, leftPad, isNumeric, StringEscapeUtils, ... -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
			<version>3.20.0</version>
		</dependency>

		<!-- Command line: replacement for the abandoned jcommander. -->
		<dependency>
			<groupId>info.picocli</groupId>
			<artifactId>picocli</artifactId>
			<version>4.7.7</version>
		</dependency>

		<!-- Jackson-style JSON parsing for the JSON-to-HTML converter. -->
		<dependency>
			<groupId>org.json</groupId>
			<artifactId>json</artifactId>
			<version>20260814</version>
		</dependency>

		<!-- JAXB API (jakarta namespace) + reference implementation. -->
		<dependency>
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
			<version>4.0.5</version>
		</dependency>
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
			<version>4.0.9</version>
		</dependency>

		<!-- Logging facade + simple stdout implementation. -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>2.0.20</version>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>2.0.20</version>
			<scope>runtime</scope>
		</dependency>

		<!-- JUnit 6 (Jupiter). -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>6.1.3</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Java 25 LTS as target. Forcing the JDK-25 javac in a separate process
			     avoids an in-process bug where the release 25 target is reported
			     as "not supported" on this JDK build. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
				<configuration>
					<fork>true</fork>
					<executable>/usr/bin/javac</executable>
					<compilerArgs>
						<arg>-Xlint:none</arg>
					</compilerArgs>
				</configuration>
			</plugin>

			<!-- src/main/generated is not part of the default Maven layout. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<id>add-generated-source</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>src/main/generated</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- (Re)generate the JAXB classes from src/main/resources/inputSchema.xsd
			     into src/main/generated.

			     Intentionally NOT bound to any lifecycle phase, so a plain
			     `mvn` / `mvn verify` never regenerates them. Run it manually:

				     mvn exec:exec

			     (an Eclipse Java Application launch on com.sun.tools.xjc.XJCFacade
			     is equivalent, see "JAXBGenerate.launch"). jaxb-xjc is supplied
			     ONLY as a dependency of THIS plugin and excluded from the
			     application classpath (includePluginDependencies=true), so it
			     stays out of the runtime/dependency tree. The fork is forced to
			     the English locale (-Duser.language/-Duser.country) so the
			     generated text is independent of the host locale, and
			     -no-header suppresses the "generated by ... on <date>" banner.

			     The checked-in files under src/main/generated are only rewritten
			     when you explicitly run the goal above. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.6.4</version>
				<dependencies>
					<!-- XJC compiler, isolated to this plugin: NOT part of the
					     application classpath, only on the exec classpath. Pulls
					     jaxb-runtime + jakarta.xml.bind-api transitively (JAXB 4). -->
					<dependency>
						<groupId>org.glassfish.jaxb</groupId>
						<artifactId>jaxb-xjc</artifactId>
						<version>4.0.9</version>
					</dependency>
				</dependencies>
				<configuration>
					<executable>${java.home}/bin/java</executable>
					<includePluginDependencies>true</includePluginDependencies>
					<!-- xjc uses -p for the target package. Disable the plugin's
					     Java module-path handling so the -p argument is passed through
					     verbatim instead of being swallowed. -->
					<longModulepath>false</longModulepath>
					<arguments>
						<!-- Force English messages regardless of host locale. -->
						<argument>-Duser.language=en</argument>
						<argument>-Duser.country=US</argument>
						<!-- inject the exec:exec classpath, then the xjc main class. -->
						<argument>-cp</argument>
						<classpath />
						<argument>com.sun.tools.xjc.XJCFacade</argument>
						<argument>-d</argument>
						<argument>${project.basedir}/src/main/generated</argument>
						<argument>-p</argument>
						<argument>io.ccw.toccer.backend.generated</argument>
						<argument>-readOnly</argument>
						<argument>-no-header</argument>
						<argument>${project.basedir}/src/main/resources/inputSchema.xsd</argument>
					</arguments>
				</configuration>
			</plugin>

			<!-- Code style checks (default Sun checks). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>3.6.0</version>
				<dependencies>
					<dependency>
						<groupId>com.puppycrawl.tools</groupId>
						<artifactId>checkstyle</artifactId>
						<version>14.3.0</version>
					</dependency>
				</dependencies>
				<configuration>
					<configLocation>sun_checks.xml</configLocation>
					<suppressionsLocation>config/checkstyle-suppressions.xml</suppressionsLocation>
					<consoleOutput>true</consoleOutput>
					<failsOnError>true</failsOnError>
					<violationSeverity>warning</violationSeverity>
				</configuration>
				<executions>
					<execution>
						<id>checkstyle-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- JUnit 6 runs via surefire. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.6.0</version>
			</plugin>

		<!-- Executable jar for the CLI. -->
		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-jar-plugin</artifactId>
			<version>3.4.2</version>
			<configuration>
				<archive>
					<manifest>
						<mainClass>io.ccw.toccer.backend.ToccerMain</mainClass>
					</manifest>
				</archive>
			</configuration>
		</plugin>

		<!-- Fat jar: shades the runtime dependencies into the main artifact so
		     that `java -jar toccer-backend-0.0.1.jar` works without an
		     external classpath. ServicesResourceTransformer merges the
		     META-INF/services files (needed for the JAXB ServiceLoader
		     lookups) and signed-jar entries are dropped, which would
		     otherwise invalidate the signatures. -->
		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-shade-plugin</artifactId>
			<version>3.6.0</version>
			<executions>
				<execution>
					<phase>package</phase>
					<goals>
						<goal>shade</goal>
					</goals>
					<configuration>
						<createDependencyReducedPom>false</createDependencyReducedPom>
						<transformers>
							<transformer
								implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
						</transformers>
						<filters>
							<filter>
								<artifact>*:*</artifact>
								<excludes>
									<exclude>META-INF/*.SF</exclude>
									<exclude>META-INF/*.DSA</exclude>
									<exclude>META-INF/*.RSA</exclude>
								</excludes>
							</filter>
						</filters>
					</configuration>
				</execution>
			</executions>
		</plugin>
		</plugins>
	</build>
</project>
